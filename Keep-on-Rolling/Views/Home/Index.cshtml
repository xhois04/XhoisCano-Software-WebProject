@{
    ViewData["Title"] = "INDEX";
}

<section class="hero">
    <canvas id="waveCanvas"></canvas>
    <div class="hero-content">
        <div class="hero-tag">// TRANSMISSION_ACTIVE</div>
        <h1 class="hero-title" data-text="MUSIC TWINS">MUSIC TWINS</h1>
        <p class="hero-sub">SEARCH // RATE // DISCOVER // SHARE</p>
    </div>
</section>

<!-- PLAYER BAR -->
<div class="player-bar" id="playerBar">
    <div class="player-track-info">
        <div class="player-track-name" id="playerTrackName">NO TRACK LOADED</div>
        <div class="player-track-artist" id="playerTrackArtist">_ _ _</div>
    </div>
    <div class="player-controls">
        <button class="ctrl-btn" onclick="prevTrack()">&#9664;&#9664;</button>
        <button class="ctrl-btn play-pause" id="playPauseBtn" onclick="togglePlay()">&#9654;</button>
        <button class="ctrl-btn" onclick="nextTrack()">&#9654;&#9654;</button>
    </div>
    <div class="player-progress">
        <span class="time-label" id="currentTime">0:00</span>
        <div class="progress-bar-wrap" id="progressWrap" onclick="seekTo(event)">
            <div class="progress-fill" id="progressFill"></div>
        </div>
        <span class="time-label" id="totalTime">0:00</span>
    </div>
    <div class="player-volume">
        <span class="vol-icon">VOL</span>
        <input type="range" class="vol-slider" id="volSlider" min="0" max="1" step="0.01" value="0.8" oninput="setVolume(this.value)">
    </div>
</div>

<!-- HOT TRACKS -->
<section class="tracks-section" id="hotTracksSection" style="padding-bottom:0">
    <div class="section-header">
        <h2 class="section-title">// HOT_TRACKS</h2>
        <span style="font-size:.65rem;color:var(--text-dim);letter-spacing:.1em">TOP 10 MOST RATED</span>
    </div>
    <div id="hotTracksList" class="tracks-grid">
        <div style="color:var(--text-dim);font-size:.7rem;grid-column:1/-1">// LOADING...</div>
    </div>
</section>

<!-- FRIEND ACTIVITY -->
<section class="tracks-section" id="friendActivitySection" style="display:none;padding-bottom:0">
    <div class="section-header">
        <h2 class="section-title">// FRIEND_ACTIVITY</h2>
    </div>
    <div id="homeFriendActivity"></div>
</section>

<!-- SPOTIFY SEARCH -->
<section class="tracks-section" style="padding-bottom:0">
    <div class="section-header">
        <h2 class="section-title">// SPOTIFY_SEARCH</h2>
    </div>
    <div style="display:flex;gap:.75rem;margin-bottom:1.5rem">
        <input class="ax-input" id="spotifyQuery" placeholder="search tracks..." style="flex:1" onkeydown="if(event.key==='Enter')spotifySearch()">
        <button class="ax-btn primary" onclick="spotifySearch()">[ SEARCH ]</button>
    </div>
    <div id="spotifyResults" class="tracks-grid" style="display:none"></div>
</section>


<!-- COMMENTS PANEL -->
<div class="comments-panel" id="commentsPanel">
    <div class="comments-header">
        <span id="commentsTitle">// COMMENTS</span>
        <button class="close-btn" onclick="closeComments()">[ X ]</button>
    </div>
    <div class="comments-list" id="commentsList">
        <div class="comment">
            <div class="comment-meta">
                <span class="comment-user">USER_4412</span>
                <span class="comment-time">2026-05-22 03:17</span>
            </div>
            <p class="comment-text">this one hits different at 3am. classic energy.</p>
        </div>
        <div class="comment">
            <div class="comment-meta">
                <span class="comment-user">RDTN_77</span>
                <span class="comment-time">2026-05-23 18:44</span>
            </div>
            <p class="comment-text">the acid line at 2:30 is unreal. studied this for years.</p>
        </div>
    </div>
    <div class="comment-form">
        <div class="form-label">// POST_TRANSMISSION</div>
        <textarea class="ax-input ax-textarea" id="commentText" placeholder="// enter transmission..."></textarea>
        <button class="ax-btn primary" onclick="postComment()">[ TRANSMIT ]</button>
    </div>
</div>

<!-- RATE MODAL -->
<div class="share-overlay" id="rateOverlay" onclick="closeRateModal()"></div>
<div class="share-modal" id="rateModal">
    <div class="share-header">
        <span>// RATE TRACK</span>
        <button class="close-btn" onclick="closeRateModal()">[ X ]</button>
    </div>
    <div style="font-size:.75rem;color:var(--accent);margin-bottom:.5rem" id="rateTrackLabel"></div>
    <div class="form-label">RATING (1–5)</div>
    <input class="ax-input" id="rateValue" type="number" min="1" max="5" value="5">
    <div class="form-label" style="margin-top:.75rem">REVIEW (optional)</div>
    <textarea class="ax-input ax-textarea" id="rateReview" placeholder="// your thoughts..."></textarea>
    <div id="rateError" style="color:var(--accent2);font-size:.65rem;min-height:1rem"></div>
    <div class="share-btns">
        <button class="ax-btn primary" onclick="submitRating()">[ TRANSMIT ]</button>
        <button class="ax-btn secondary" onclick="closeRateModal()">[ CANCEL ]</button>
    </div>
</div>

<!-- SHARE MODAL -->
<div class="share-overlay" id="shareOverlay" onclick="closeShare()"></div>
<div class="share-modal" id="shareModal">
    <div class="share-header">
        <span>// SHARE_LINK</span>
        <button class="close-btn" onclick="closeShare()">[ X ]</button>
    </div>
    <div class="share-url" id="shareUrl"></div>
    <div class="share-btns">
        <button class="ax-btn primary" onclick="copyShareLink()">[ COPY LINK ]</button>
        <button class="ax-btn secondary" onclick="closeShare()">[ DISMISS ]</button>
    </div>
    <div class="share-copied" id="shareCopied">// COPIED TO CLIPBOARD</div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    loadHotTracks();
    if (Auth.isLoggedIn()) loadHomeFriendActivity();
});

async function loadHotTracks() {
    const container = document.getElementById('hotTracksList');
    try {
        const tracks = await ApiRatings.getTop();
        if (!tracks.length) {
            container.innerHTML = '<div style="color:var(--text-dim);font-size:.7rem;grid-column:1/-1">// NO RATINGS YET — BE THE FIRST</div>';
            return;
        }
        container.innerHTML = tracks.map((t, i) => `
            <div class="track-card">
                <div style="color:var(--text-dim);font-size:.6rem;margin-bottom:.25rem">#${i + 1}</div>
                <div class="track-title">${escHtml(t.trackName)}</div>
                <div class="track-album">${escHtml(t.artistName)}</div>
                <div style="color:var(--accent);font-size:.7rem;margin:.25rem 0">
                    ${'★'.repeat(Math.round(t.avgRating))}${'☆'.repeat(5 - Math.round(t.avgRating))}
                    ${t.avgRating.toFixed(1)}/5
                    <span style="color:var(--text-dim);font-size:.6rem">(${t.ratingCount} rating${t.ratingCount !== 1 ? 's' : ''})</span>
                </div>
                <div class="track-actions" style="margin-top:.5rem">
                    <button class="act-btn"
                        data-spotifyid="${escHtml(t.spotifyTrackId)}"
                        data-trackname="${escHtml(t.trackName)}"
                        data-artist="${escHtml(t.artistName)}"
                        onclick="spotifyPlayTrackFromCard(this)">[ PLAY ]</button>
                </div>
            </div>`).join('');
    } catch {
        container.innerHTML = '<div style="color:var(--text-dim);font-size:.7rem;grid-column:1/-1">// COULD NOT LOAD HOT TRACKS</div>';
    }
}

async function loadHomeFriendActivity() {
    try {
        const items = await ApiFriends.activity();
        if (!items.length) return;
        document.getElementById('friendActivitySection').style.display = '';
        document.getElementById('homeFriendActivity').innerHTML =
            '<div class="tracks-grid">' +
            items.slice(0, 8).map(r => `
                <div class="track-card">
                    <div style="color:var(--accent);font-size:.65rem;margin-bottom:.25rem">${escHtml(r.username)}</div>
                    <div class="track-title">${escHtml(r.trackName)}</div>
                    <div class="track-album">${escHtml(r.artistName)}</div>
                    <div style="color:var(--accent);font-size:.7rem;margin:.25rem 0">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)} ${r.rating}/5</div>
                    ${r.review ? `<div style="color:var(--text-dim);font-size:.65rem;font-style:italic">"${escHtml(r.review)}"</div>` : ''}
                    <div style="color:var(--text-dim);font-size:.6rem;margin-top:.5rem">${r.createdAt?.slice(0,16).replace('T',' ')}</div>
                </div>`).join('') +
            '</div>';
    } catch { /* not logged in or no friends */ }
}
</script>
}
